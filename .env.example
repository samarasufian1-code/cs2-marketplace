# Local development defaults
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/cs2_marketplace
SESSION_SECRET=replace-with-a-long-random-secret

# Production only: keep disabled until the provider implementation is reviewed
STEAM_TRADE_PROVIDER=disabled
STEAM_TRADE_BOT_ID=
STEAM_TRADE_CALLBACK_SECRET=

# Configure a verified payment provider before enabling real deposits or withdrawals
PAYMENT_PROVIDER=disabled
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=
